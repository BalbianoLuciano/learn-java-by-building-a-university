{
  "name": "@ljbu/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "JSON Schemas of the trace, result and challenge contracts, and the TypeScript types generated from them.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.schema.json": "./*.schema.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run generate:check && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
