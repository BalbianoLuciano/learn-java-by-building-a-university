{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BalbianoLuciano/learn-java-by-building-a-university/main/packages/contracts/trace.schema.json",
  "title": "Trace",
  "description": "Execution report returned by the runner to the api (docs/ARCHITECTURE.md §5.2).",
  "oneOf": [
    { "$ref": "#/$defs/compileErrorTrace" },
    { "$ref": "#/$defs/rejectedTrace" },
    { "$ref": "#/$defs/executedTrace" }
  ],
  "$defs": {
    "compileErrorTrace": {
      "title": "CompileErrorTrace",
      "description": "The code did not compile; nothing was executed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostics"],
      "properties": {
        "status": { "const": "compile_error" },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "rejectedTrace": {
      "title": "RejectedTrace",
      "description": "The code compiled but uses something outside the bytecode allowlist; nothing was executed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "structure", "violations"],
      "properties": {
        "status": { "const": "rejected" },
        "structure": { "$ref": "#/$defs/structure" },
        "violations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/violation" }
        }
      }
    },
    "executedTrace": {
      "title": "ExecutedTrace",
      "description": "The code ran in the child JVM, to completion or until an exception or a limit stopped it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "structure",
        "stdout",
        "steps",
        "heap",
        "statics",
        "exception",
        "limits"
      ],
      "properties": {
        "status": { "enum": ["completed", "runtime_error", "timeout", "limit_exceeded"] },
        "structure": { "$ref": "#/$defs/structure" },
        "stdout": {
          "description": "Standard output, cut at the output limit.",
          "type": "string"
        },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "heap": {
          "description": "Final state of every object referenced by the trace, keyed by object id.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/objectId" },
          "additionalProperties": { "$ref": "#/$defs/heapObject" }
        },
        "statics": {
          "description": "Final values of the static fields of learner classes, keyed by class name.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/value" }
          }
        },
        "exception": {
          "description": "The uncaught exception that ended the program, if any.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/exceptionInfo" }]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "truncated", "exceeded"],
          "properties": {
            "steps": {
              "description": "Number of steps recorded.",
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "description": "True when the program was cut before it finished on its own.",
              "type": "boolean"
            },
            "exceeded": {
              "description": "The limit that cut the program when status is limit_exceeded; null otherwise.",
              "enum": ["steps", "objects", "output", "call_depth", null]
            }
          }
        }
      }
    },
    "diagnostic": {
      "title": "Diagnostic",
      "description": "A compilation error: a javac diagnostic, or a runner rule reported with an ljbu.err.* code.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "column", "code", "message"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "code": {
          "description": "javac diagnostic code, e.g. compiler.err.cant.resolve.location.",
          "type": "string"
        },
        "message": { "description": "Original javac message.", "type": "string" }
      }
    },
    "violation": {
      "title": "Violation",
      "description": "A reference to a class, method or field outside the allowlist.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "symbol"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "symbol": {
          "description": "The forbidden reference, e.g. java.lang.System.exit.",
          "type": "string"
        }
      }
    },
    "structure": {
      "title": "Structure",
      "description": "Static structure of the learner's compiled classes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["classes"],
      "properties": {
        "classes": { "type": "array", "items": { "$ref": "#/$defs/classInfo" } }
      }
    },
    "visibility": {
      "title": "Visibility",
      "enum": ["public", "protected", "package", "private"]
    },
    "classInfo": {
      "title": "ClassInfo",
      "description": "Types are written with simple names and their type arguments, e.g. List<Departamento>.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "abstract",
        "superclass",
        "interfaces",
        "file",
        "line",
        "fields",
        "constructors",
        "methods"
      ],
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["class", "interface", "enum", "record"] },
        "abstract": { "type": "boolean" },
        "superclass": {
          "description": "Null when the class has no explicit superclass.",
          "type": ["string", "null"]
        },
        "interfaces": { "type": "array", "items": { "type": "string" } },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/fieldInfo" } },
        "constructors": { "type": "array", "items": { "$ref": "#/$defs/constructorInfo" } },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/methodInfo" } }
      }
    },
    "fieldInfo": {
      "title": "FieldInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "visibility", "final", "static", "line"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "final": { "type": "boolean" },
        "static": { "type": "boolean" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "constructorInfo": {
      "title": "ConstructorInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterTypes", "visibility", "line"],
      "properties": {
        "parameterTypes": { "type": "array", "items": { "type": "string" } },
        "visibility": { "$ref": "#/$defs/visibility" },
        "line": {
          "description": "Line of the declaration; the line of the class for an implicit constructor.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "methodInfo": {
      "title": "MethodInfo",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "returnType",
        "parameterTypes",
        "visibility",
        "static",
        "abstract",
        "override",
        "line"
      ],
      "properties": {
        "name": { "type": "string" },
        "returnType": { "type": "string" },
        "parameterTypes": { "type": "array", "items": { "type": "string" } },
        "visibility": { "$ref": "#/$defs/visibility" },
        "static": { "type": "boolean" },
        "abstract": { "type": "boolean" },
        "override": {
          "description": "True when the method is annotated with @Override in the source.",
          "type": "boolean"
        },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "objectId": {
      "title": "ObjectId",
      "description": "Identifier of a traced object, stable within one trace.",
      "type": "string",
      "pattern": "^o[0-9]+$"
    },
    "value": {
      "title": "Value",
      "description": "A Java value. Strings and wrappers are values (they are immutable); every other object is a reference.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["int"],
          "properties": {
            "int": { "description": "byte, short, int or long.", "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["double"],
          "properties": {
            "double": {
              "description": "float or double; the non-finite values travel as strings.",
              "oneOf": [{ "type": "number" }, { "enum": ["NaN", "Infinity", "-Infinity"] }]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["boolean"],
          "properties": { "boolean": { "type": "boolean" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["char"],
          "properties": { "char": { "type": "string", "minLength": 1, "maxLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["string"],
          "properties": {
            "string": { "description": "Cut at 1000 characters.", "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": { "ref": { "$ref": "#/$defs/objectId" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["null"],
          "properties": { "null": { "const": true } }
        }
      ]
    },
    "heapObject": {
      "title": "HeapObject",
      "oneOf": [
        { "$ref": "#/$defs/instanceObject" },
        { "$ref": "#/$defs/sequenceObject" },
        { "$ref": "#/$defs/mapObject" }
      ]
    },
    "instanceObject": {
      "title": "InstanceObject",
      "description": "An object with its fields. Objects of classes the learner did not write carry no fields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "fields"],
      "properties": {
        "type": { "type": "string" },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
      }
    },
    "sequenceObject": {
      "title": "SequenceObject",
      "description": "An array, a list or a set, with at most its first 200 elements.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size", "elements"],
      "properties": {
        "type": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/value" } }
      }
    },
    "mapObject": {
      "title": "MapObject",
      "description": "A map, with at most its first 200 entries.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size", "entries"],
      "properties": {
        "type": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": {
              "key": { "$ref": "#/$defs/value" },
              "value": { "$ref": "#/$defs/value" }
            }
          }
        }
      }
    },
    "exceptionInfo": {
      "title": "ExceptionInfo",
      "description": "An exception. file and line point to the first frame in learner code.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message", "file", "line"],
      "properties": {
        "type": { "description": "Fully qualified class name.", "type": "string" },
        "message": { "type": ["string", "null"] },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "step": {
      "title": "Step",
      "description": "One traced event in learner code. file and line say where it happened.",
      "oneOf": [
        { "$ref": "#/$defs/objectCreatedStep" },
        { "$ref": "#/$defs/fieldSetStep" },
        { "$ref": "#/$defs/localSetStep" },
        { "$ref": "#/$defs/callStep" },
        { "$ref": "#/$defs/returnStep" },
        { "$ref": "#/$defs/outputStep" },
        { "$ref": "#/$defs/exceptionStep" }
      ]
    },
    "objectCreatedStep": {
      "title": "ObjectCreatedStep",
      "description": "An object of a learner class was created. The line is the one with the new expression.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "file", "line", "event", "object"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "event": { "const": "object_created" },
        "object": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type"],
          "properties": {
            "id": { "$ref": "#/$defs/objectId" },
            "type": { "type": "string" }
          }
        }
      }
    },
    "fieldSetStep": {
      "title": "FieldSetStep",
      "description": "A field of a learner class was written. target is the object; a static field carries ownerClass instead.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "file", "line", "event", "field", "value"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "event": { "const": "field_set" },
        "target": { "$ref": "#/$defs/objectId" },
        "ownerClass": { "type": "string" },
        "field": { "type": "string" },
        "value": { "$ref": "#/$defs/value" }
      }
    },
    "localSetStep": {
      "title": "LocalSetStep",
      "description": "A local variable of a learner method received a value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "file", "line", "event", "method", "name", "value"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "event": { "const": "local_set" },
        "method": { "$ref": "#/$defs/methodName" },
        "name": { "type": "string" },
        "value": { "$ref": "#/$defs/value" }
      }
    },
    "callStep": {
      "title": "CallStep",
      "description": "A learner method or constructor started. The line is the call site when the caller is learner code. method names the implementation that runs; target is the receiver, absent in static methods.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "file", "line", "event", "method", "args"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "event": { "const": "call" },
        "method": { "$ref": "#/$defs/methodName" },
        "target": { "$ref": "#/$defs/objectId" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/value" } }
      }
    },
    "returnStep": {
      "title": "ReturnStep",
      "description": "A learner method or constructor finished normally. value is absent when it returns void.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "file", "line", "event", "method"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "event": { "const": "return" },
        "method": { "$ref": "#/$defs/methodName" },
        "value": { "$ref": "#/$defs/value" }
      }
    },
    "outputStep": {
      "title": "OutputStep",
      "description": "The line wrote text to standard output.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "file", "line", "event", "text"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "event": { "const": "output" },
        "text": { "type": "string" }
      }
    },
    "exceptionStep": {
      "title": "ExceptionStep",
      "description": "An exception was thrown. caught says whether learner code catches it; otherwise it ends the program.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "file", "line", "event", "exception", "caught"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "event": { "const": "exception" },
        "exception": { "$ref": "#/$defs/exceptionInfo" },
        "caught": { "type": "boolean" }
      }
    },
    "methodName": {
      "title": "MethodName",
      "description": "Class and method joined by a dot, e.g. Main.main; constructors are Class.<init>.",
      "type": "string"
    }
  }
}
