{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BalbianoLuciano/learn-java-by-building-a-university/main/packages/contracts/result.schema.json",
  "title": "RunResult",
  "description": "Result of a run, returned by the api to the web (docs/ARCHITECTURE.md §5.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "outcome", "progress", "pieces", "log", "timeline", "stdout", "classes"],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "$ref": "#/$defs/state"
    },
    "progress": {
      "description": "Checks of the challenge that pass, out of all of them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total"],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pieces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/piece"
      }
    },
    "log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/logEntry"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineStep"
      }
    },
    "stdout": {
      "type": "string"
    },
    "classes": {
      "description": "The learner classes and interfaces of the program, in source order; empty when it did not compile.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/classInfo"
      }
    }
  },
  "$defs": {
    "state": {
      "title": "State",
      "description": "passed: correct; incomplete: something from the brief is missing; failed: it broke (docs/FEEDBACK.md §1).",
      "enum": ["passed", "incomplete", "failed"]
    },
    "archetype": {
      "title": "Archetype",
      "description": "Scene archetype from DESIGN.md §B4.",
      "enum": [
        "rectorate",
        "regional-faculty",
        "department",
        "career",
        "person",
        "inheritance-floors",
        "slot",
        "variable-sign",
        "reference-link",
        "interface-badge",
        "generic-block"
      ]
    },
    "sourceRef": {
      "title": "SourceRef",
      "description": "A line of the learner's code.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "piece": {
      "title": "Piece",
      "description": "A visual element of the model: an object the brief asks for, another object the code created, or a variable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "archetype", "state", "built", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "$ref": "#/$defs/archetype"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "built": {
          "description": "False when the brief asks for the piece and the code did not create it.",
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "sourceRef": {
          "description": "Where the code created it.",
          "$ref": "#/$defs/sourceRef"
        },
        "slots": {
          "description": "Composition slots of the piece, keyed by slot name.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/slot"
          }
        },
        "target": {
          "description": "For a variable: the piece it points to. Absent when it points to nothing.",
          "type": "string"
        },
        "floors": {
          "description": "For inheritance-floors: the classes of the object from the top of its hierarchy down to its own class, one floor each.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "description": "The learner interfaces the class of the object implements, directly or through its superclasses: one badge each.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "description": "The learner class of the object (the blueprint it was built from); absent for variable signs.",
          "type": "string"
        },
        "fields": {
          "description": "The values of the object's fields at the end of the run, in declaration order (inherited fields first).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/value"
              },
              "pieceId": {
                "description": "For a reference to a drawn object, its piece.",
                "type": "string"
              },
              "pieceIds": {
                "description": "For a collection or an array, the pieces of its elements, in order.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "slot": {
      "title": "Slot",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "pieceIds"],
      "properties": {
        "state": {
          "enum": ["filled", "missing"]
        },
        "pieceIds": {
          "description": "Pieces that occupy the slot.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "logEntry": {
      "title": "LogEntry",
      "description": "A log message: what happened, why, where and a hint (docs/FEEDBACK.md §3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "title", "why"],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "title": {
          "description": "What happened.",
          "type": "string",
          "minLength": 1
        },
        "why": {
          "description": "The Java concept involved.",
          "type": "string",
          "minLength": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "pieceId": {
          "type": "string",
          "minLength": 1
        },
        "checkId": {
          "description": "The check of the challenge this entry reports, if any.",
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "description": "Original text of the compiler or the JVM, shown under the message.",
          "type": "string"
        }
      }
    },
    "value": {
      "title": "Value",
      "description": "A Java value, as in the trace.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["int"],
          "properties": {
            "int": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["double"],
          "properties": {
            "double": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "enum": ["NaN", "Infinity", "-Infinity"]
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["boolean"],
          "properties": {
            "boolean": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["char"],
          "properties": {
            "char": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["string"],
          "properties": {
            "string": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["null"],
          "properties": {
            "null": {
              "const": true
            }
          }
        }
      ]
    },
    "timelineStep": {
      "title": "TimelineStep",
      "description": "A step of the execution, tied to a line and to the pieces it touches. name is the class created, the field or variable written, the method called or the exception thrown, depending on the event.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "sourceRef", "event"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "event": {
          "enum": [
            "object_created",
            "field_set",
            "local_set",
            "call",
            "return",
            "output",
            "exception"
          ]
        },
        "pieceId": {
          "description": "The piece created, written, called or, for a local, the variable.",
          "type": "string",
          "minLength": 1
        },
        "targetPieceId": {
          "description": "The piece a field or a variable points to after the step.",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "text": {
          "description": "Output written, or message of the exception.",
          "type": "string"
        },
        "caught": {
          "description": "For an exception: whether the code catches it.",
          "type": "boolean"
        }
      }
    },
    "classInfo": {
      "title": "ClassInfo",
      "description": "A learner class, as the runner extracted it: the blueprint the model draws. Types are written with simple names and their type arguments, e.g. List<Departamento>.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "abstract",
        "superclass",
        "interfaces",
        "file",
        "line",
        "fields",
        "constructors",
        "methods"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": ["class", "interface", "enum", "record"]
        },
        "abstract": {
          "type": "boolean"
        },
        "superclass": {
          "description": "Null when the class has no explicit superclass.",
          "type": ["string", "null"]
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldInfo"
          }
        },
        "constructors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constructorInfo"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/methodInfo"
          }
        }
      }
    },
    "fieldInfo": {
      "title": "FieldInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "visibility", "final", "static", "line"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "final": {
          "type": "boolean"
        },
        "static": {
          "type": "boolean"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "constructorInfo": {
      "title": "ConstructorInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterTypes", "visibility", "line"],
      "properties": {
        "parameterTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "line": {
          "description": "Line of the declaration; the line of the class for an implicit constructor.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "methodInfo": {
      "title": "MethodInfo",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "returnType",
        "parameterTypes",
        "visibility",
        "static",
        "abstract",
        "override",
        "line"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "returnType": {
          "type": "string"
        },
        "parameterTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "static": {
          "type": "boolean"
        },
        "abstract": {
          "type": "boolean"
        },
        "override": {
          "description": "True when the method is annotated with @Override in the source.",
          "type": "boolean"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "visibility": {
      "title": "Visibility",
      "enum": ["public", "protected", "package", "private"]
    }
  }
}
