{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BalbianoLuciano/learn-java-by-building-a-university/main/packages/contracts/run-request.schema.json",
  "title": "RunRequest",
  "description": "Body of POST /api/v1/runs, sent by the web to the api.",
  "type": "object",
  "additionalProperties": false,
  "required": ["challengeId", "files"],
  "properties": {
    "challengeId": { "type": "string", "pattern": "^m[1-9][0-9]*-[0-9]{2}$" },
    "files": {
      "description": "The editable files of the challenge, as the learner left them.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*\\.java$" },
          "content": { "type": "string" }
        }
      }
    }
  }
}
